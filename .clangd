# Configuration of clangd, read by every editor using it as language server.
# clangd takes the compile commands from compile_commands.json, which CMake writes into the build
# directory; it finds build/compile_commands.json on its own, see docs/setup/discopop.md for others.
CompileFlags:
  # added by LLVM's HandleLLVMOptions when building with GCC; clang does not know it
  Remove: [-fno-lifetime-dse]
